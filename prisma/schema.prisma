generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClassScheduleStatus {
  OPEN
  CLOSED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum PackageStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  phone        String?      @unique
  passwordHash String
  displayName  String
  status       UserStatus   @default(ACTIVE)
  roleId       Int
  role         Role         @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  memberships Membership[]
  registrations ClassRegistration[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, roleId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model MembershipPackage {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  description  String?
  price        Int
  durationDays Int
  sessionLimit Int?
  sportType    String
  benefits     String?
  isBestSeller Boolean       @default(false)
  status       PackageStatus @default(ACTIVE)
  memberships  Membership[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, sportType])
}

model Membership {
  id                    Int              @id @default(autoincrement())
  userId                Int
  packageId             Int?
  packageNameSnapshot   String?
  sportTypeSnapshot     String?
  durationDaysSnapshot  Int?
  listedPriceSnapshot   Int?
  startDate             DateTime
  endDate               DateTime
  status                MembershipStatus @default(ACTIVE)
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  package   MembershipPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([userId, status, endDate])
  @@index([packageId])
}

model ClassSchedule {
  id            Int                 @id @default(autoincrement())
  courseName    String
  classDate     DateTime
  startTime     DateTime
  endTime       DateTime
  room          String
  capacity      Int
  status        ClassScheduleStatus  @default(OPEN)
  registrations ClassRegistration[]
  createdAt     DateTime            @default(now())

  @@index([status, classDate, startTime])
}

model ClassRegistration {
  id              Int                @id @default(autoincrement())
  userId          Int
  classScheduleId Int
  status          RegistrationStatus @default(CONFIRMED)
  registeredAt    DateTime           @default(now())
  cancelledAt     DateTime?
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSchedule   ClassSchedule      @relation(fields: [classScheduleId], references: [id], onDelete: Cascade)

  @@unique([userId, classScheduleId])
  @@index([classScheduleId, status])
}
